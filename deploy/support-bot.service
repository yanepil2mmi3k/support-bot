[Unit]
Description=Telegram support bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=supportbot
Group=supportbot
WorkingDirectory=/opt/support-bot
EnvironmentFile=/opt/support-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/support-bot/.venv/bin/python -m support_bot
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/support-bot/data /opt/support-bot/logs
ExecStartPre=/usr/bin/mkdir -p /opt/support-bot/data /opt/support-bot/logs
ExecStartPre=/usr/bin/chown supportbot:supportbot /opt/support-bot/data /opt/support-bot/logs

[Install]
WantedBy=multi-user.target
